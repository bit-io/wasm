[package]
-> name        => hello-page
-> version     => 0.1.0
-> description => H# page compiled to WebAssembly with the wasm library
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

! a bare `bit` builds build/hello-page.js + build/hello-page.wasm  (`bit --target wasm` does the same explicitly)
[default-build]
-> profile => release
-> emit    => bin
-> target  => wasm

[dependencies]
-> wasm => newest
