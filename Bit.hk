[package]
-> name        => wasm
-> version     => 0.2.0
-> description => Web/WASM library for H# — browser bindings (console, DOM, events, timers, storage, fetch, canvas) for the wasm32 target, built by emcc.
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src       => src
-> lib-entry => src/lib.h#

[build]
-> link   => static
-> target => h#

[lib]
-> output => hlib

[pack]
-> contents    => [sources, docs]
-> compression => zstd
-> files       => [emscripten/hsharp-web.js, emscripten/web_bridge.cpp, scripts/gen-emscripten-bridge.py]

[dependencies]
