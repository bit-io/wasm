[package]
-> name        => wasm
-> version     => 0.1.0
-> description => Web/WASM library for H# — browser bindings (console, DOM, events, timers, storage, fetch, canvas) over a tiny Rust runtime (extern static [rust]), compiled for wasm32.
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static
-> native => cargo build --release --lib --manifest-path runtime/src/Cargo.toml --target wasm32-unknown-unknown
-> native-lib-path => runtime/src/target/wasm32-unknown-unknown/release
-> native-skip-if => runtime/src/target/wasm32-unknown-unknown/release/libhsharp_wasm_runtime.a

[lib]
-> output => hlib

[pack]
-> contents    => [hlib, a, sources, docs]
-> compression => zstd
-> files       => [glue/hsharp-web-loader.js]

[dependencies]
